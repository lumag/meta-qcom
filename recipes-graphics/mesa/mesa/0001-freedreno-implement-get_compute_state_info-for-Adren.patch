From ceda3ce47046eaecc8ef09276529cfffeab1f7b1 Mon Sep 17 00:00:00 2001
From: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Date: Mon, 29 Sep 2025 02:43:47 +0300
Subject: [PATCH 1/3] freedreno: implement get_compute_state_info for Adreno
 5xx

Preparation for OpenCL (rusticl) support.

Signed-off-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Upstream-Status: Submitted [https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/37626]
---
 .../drivers/freedreno/a5xx/fd5_compute.c      | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_compute.c b/src/gallium/drivers/freedreno/a5xx/fd5_compute.c
index 4344074f58f4..19f9b4de9bd2 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_compute.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_compute.c
@@ -167,6 +167,27 @@ fd5_launch_grid(struct fd_context *ctx,
    }
 }
 
+static void
+fd5_get_compute_state_info(struct pipe_context *pctx, void *cso, struct pipe_compute_state_object_info *cinfo)
+{
+   static struct ir3_shader_key key; /* static is implicitly zeroed */
+   struct ir3_shader_state *hwcso = (struct ir3_shader_state *)cso;
+   struct ir3_shader_variant *v = ir3_shader_variant(ir3_get_shader(hwcso), key, false, &pctx->debug);
+   const struct fd_dev_info *info = fd_context(pctx)->screen->info;
+   uint32_t threadsize_base = info->threadsize_base;
+
+   cinfo->max_threads = threadsize_base * info->max_waves;
+   cinfo->simd_sizes = threadsize_base;
+   cinfo->preferred_simd_size = threadsize_base;
+
+   unsigned reg_file_size_vec4 = v->compiler->reg_size_vec4 * threadsize_base * info->wave_granularity;
+   unsigned vec4_regs_per_thread = MAX2(v->info.max_reg + 1, 1);
+
+   cinfo->max_threads = MIN2(cinfo->max_threads, reg_file_size_vec4 / vec4_regs_per_thread);
+
+   cinfo->private_memory = v->pvtmem_size;
+}
+
 void
 fd5_compute_init(struct pipe_context *pctx) disable_thread_safety_analysis
 {
@@ -174,4 +195,5 @@ fd5_compute_init(struct pipe_context *pctx) disable_thread_safety_analysis
    ctx->launch_grid = fd5_launch_grid;
    pctx->create_compute_state = ir3_shader_compute_state_create;
    pctx->delete_compute_state = ir3_shader_state_delete;
+   pctx->get_compute_state_info = fd5_get_compute_state_info;
 }
